APP_NAME="Ovalete Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://ovalete.test

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# PUBLIC_STORAGE_URL=   # optional: CDN base for uploaded media (defaults to APP_URL/storage)
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
QUEUE_CONVERSIONS_BY_DEFAULT=true

# WooCommerce migration source (public Store API needs no credentials)
WOO_BASE_URL=https://ovaletestore.com
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

ADMIN_EMAIL=admin@ovalete.test
WOO_ADMIN_USER=
WOO_ADMIN_PASSWORD=

# Google Analytics 4 reports in the admin (spatie/laravel-analytics). Property ID = the numeric GA4 property id.
# The service-account JSON goes to storage/app/analytics/service-account-credentials.json (git-ignored) unless
# ANALYTICS_CREDENTIALS_PATH points elsewhere. Add the service-account e-mail as "Viewer" on the GA4 property.
ANALYTICS_PROPERTY_ID=
ANALYTICS_CREDENTIALS_PATH=
ANALYTICS_CACHE_MINUTES=60
# Storefront tracking (gtag.js); defaults to on in production only.
# ANALYTICS_TRACKING=true
